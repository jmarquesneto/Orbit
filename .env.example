# ------------------------------------------------------------------
# Modelo de configuração. NÃO coloque segredos reais aqui.
# Gere o .env real com:   ./scripts/generate-env.sh
# Os valores "<gerado>" são substituídos por bytes aleatórios do openssl.
# ------------------------------------------------------------------

# Prefixo dos containers, imagens e volumes
COMPOSE_PROJECT_NAME=finance

# --- Exposição -----------------------------------------------------
# Só o frontend publica porta. 127.0.0.1 = acessível apenas nesta máquina
# (coloque um proxy reverso com TLS na frente em produção).
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3010
WEB_ORIGIN=http://localhost:3010

NODE_ENV=production
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL 16) --------------------------------
DB_NAME=finance
# Superusuário: usado só no bootstrap do container do banco.
DB_SUPERUSER=db_admin
DB_SUPERUSER_PASSWORD=<gerado>
# Dono do schema: usado só pelas migrações.
DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD=<gerado>
# Papel de runtime da API: apenas DML, sujeito a Row-Level Security.
DB_APP_USER=app_runtime
DB_APP_PASSWORD=<gerado>

# --- Redis ---------------------------------------------------------
REDIS_PASSWORD=<gerado>

# --- Autenticação ---------------------------------------------------
# Segredos distintos para access e refresh token (≥ 32 bytes cada).
JWT_ACCESS_SECRET=<gerado>
JWT_REFRESH_SECRET=<gerado>
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Assina cookies de sessão e o token CSRF.
SESSION_SECRET=<gerado>

# --- Criptografia de dados em repouso (AES-256-GCM) -----------------
# Exatamente 32 bytes em base64 (ex.: segredo do MFA).
DATA_ENCRYPTION_KEY=<gerado-base64-32>
