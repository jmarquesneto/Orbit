# ------------------------------------------------------------------
# Variáveis da stack do OpenMediaVault (caixa "Environment").
# Gere a versão real no Windows com:
#   powershell -ExecutionPolicy Bypass -File .\scripts\generate-env.ps1 -Omv
# O script pergunta o IP do NAS, a pasta e o seu e-mail, e cria deploy\omv\orbit.env.
# ------------------------------------------------------------------

# --- Caminhos ABSOLUTOS no NAS --------------------------------------
# Pasta onde você extraiu o código (tem apps/, infra/, deploy/ ...).
ORBIT_APP_DIR=<pasta-do-codigo>
# Pasta dos dados (o banco fica em <esta pasta>/postgres). Faça backup dela.
ORBIT_DATA_DIR=<pasta-dos-dados>

# --- Endereço do site -----------------------------------------------
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3010
WEB_ORIGIN=<endereco-do-site>

# --- Primeiro acesso (sem terminal) ---------------------------------
# Se ainda não houver administrador, a API cria este e mostra uma senha
# provisória no log do container "api". Depois do 1º login pode apagar.
BOOTSTRAP_ADMIN_EMAIL=<email-do-admin>
BOOTSTRAP_ADMIN_NAME=<nome-do-admin>

LOG_LEVEL=info

# --- Banco de dados (PostgreSQL 16) --------------------------------
DB_NAME=finance
DB_SUPERUSER=db_admin
DB_SUPERUSER_PASSWORD=<gerado>
DB_MIGRATOR_USER=app_migrator
DB_MIGRATOR_PASSWORD=<gerado>
DB_APP_USER=app_runtime
DB_APP_PASSWORD=<gerado>

# --- Redis ---------------------------------------------------------
REDIS_PASSWORD=<gerado>

# --- Autenticação ---------------------------------------------------
JWT_ACCESS_SECRET=<gerado>
JWT_REFRESH_SECRET=<gerado>
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
SESSION_SECRET=<gerado>

# --- Criptografia de dados em repouso (AES-256-GCM) -----------------
DATA_ENCRYPTION_KEY=<gerado-base64-32>
